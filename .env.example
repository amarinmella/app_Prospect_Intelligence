# --- Base de datos ---
# Sin DATABASE_URL se usa PGlite local (.data/pglite). En producción: cadena de conexión de Supabase
# (Project Settings → Database → Connection string, modo "Transaction pooler").
DATABASE_URL=
# true = aplica supabase/migrations al arrancar contra Postgres remoto (o usa `npm run db:migrate`)
AUTO_MIGRATE=false

# --- Acceso a la app (obligatorio en producción) ---
APP_PASSWORD=
SESSION_SECRET=

# --- Fuentes de datos (ver docs/fuentes-de-datos.md) ---
GOOGLE_MAPS_API_KEY=
PAGESPEED_API_KEY=
OSM_USER_AGENT=
HUNTER_API_KEY=
OUTSCRAPER_API_KEY=

# --- IA (interpretación de análisis y mensajes) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Nombre que firma los emails generados (por defecto: Innova IA Studio)
OUTREACH_SENDER_NAME=
